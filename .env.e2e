# The end-to-end build (npm run build:e2e, used by npm run test:e2e).
#
# Committed on purpose, and holds no secret: supabase.e2e.test is a reserved
# name that can never resolve, so the browser cannot reach any real project
# from the e2e build. Playwright answers this host itself (e2e/fakeSupabase.ts);
# any request it does not answer fails loudly instead of touching real data.
#
# Vite gives this file priority over .env and .env.local for --mode e2e, so a
# developer's own .env (which may point at the real project for npm run dev)
# never reaches the tests. The live journeys (npm run test:e2e:live, in CI)
# override both values from the environment with the local Supabase stack's.
VITE_SUPABASE_URL=https://supabase.e2e.test
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e_not_a_real_key
VITE_SUPPORT_EMAIL=hanna@itala.fyi
