# Ingestion credentials. Node-only, read by scripts/catalog/** at build time.
#
# Deliberately NOT prefixed with VITE_: anything Vite exposes ends up in the
# browser bundle, and these are application credentials, not public config.
# The app itself never makes an authenticated request to any provider.
#
# Copy to .env and fill in. .env is gitignored; never commit a real value.

# https://www.pexels.com/api/ - instant on signup. 200 req/hr, 20,000/month.
PEXELS_API_KEY=

# https://unsplash.com/oauth/applications - the Access Key (a long string),
# not the numeric Application ID. Demo apps get 50 req/hr.
UNSPLASH_ACCESS_KEY=

# https://api.data.gov/signup/ - Smithsonian Open Access. 1,000 req/hr.
SMITHSONIAN_API_KEY=
